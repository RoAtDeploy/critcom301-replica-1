{
  "name": "IndustryDefinition",
  "type": "object",
  "properties": {
    "term": {
      "type": "string",
      "description": "The abbreviation or term (e.g. COSS, PICOP)"
    },
    "definition": {
      "type": "string",
      "description": "Full definition or explanation of the term"
    }
  },
  "required": [
    "term",
    "definition"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}