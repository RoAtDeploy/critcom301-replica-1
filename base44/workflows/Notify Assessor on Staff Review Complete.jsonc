{
  "name": "Notify Assessor on Staff Review Complete",
  "description": "Emails the assessor (report creator) when a staff member submits their review and the report status becomes staff_reviewed.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"staff_reviewed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Report"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_assessor_on_staff_review_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAssessorOfReview",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAssessorOfReview"
  }
}